generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  INVENTORY_MANAGER
  PRODUCTION_MANAGER
  EMPLOYEE
}

model Business {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  phone     String?
  email     String?
  address   String?
  currency  String  @default("ETB")
  timezone  String  @default("Africa/Addis_Ababa")
  isActive  Boolean @default(true)

  memberships              Membership[]
  customers                Customer[]
  employees                Employee[]
  suppliers                Supplier[]
  units                    UnitOfMeasure[]
  materials                Material[]
  products                 Product[]
  purchases                Purchase[]
  stockMovements           StockMovement[]
  costLayers               MaterialCostLayer[]
  orders                   CustomerOrder[]
  productionBatches        ProductionBatch[]
  productionMaterialUsages ProductionMaterialUsage[]
  expenses                 Expense[]
  productionCostSheets     ProductionCostSheet[]
  invoices                 Invoice[]
  payments                 Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(cuid())
  fullName     String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id         String         @id @default(cuid())
  businessId String
  userId     String
  role       MembershipRole @default(EMPLOYEE)
  isActive   Boolean        @default(true)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model Session {
  id                String   @id @default(cuid())
  membershipId      String
  tokenHash         String   @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  rotatedToSessionId String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, expiresAt])
}

model Customer {
  id         String          @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  orders     CustomerOrder[]
  invoices   Invoice[]
  isActive   Boolean         @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
  @@index([businessId, phone])
}

enum MaterialType {
  FABRIC
  POLYMER
  THREAD
  ACCESSORY
  PACKAGING
  OTHER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum CostLayerStatus {
  OPEN
  DEPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  DELIVERED
  CANCELLED
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  TRANSPORT
  MAINTENANCE
  SUPPLIES
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

model Employee {
  id                String                    @id @default(cuid())
  businessId        String
  employeeCode      String?
  fullName          String
  phone             String?
  jobTitle          String?
  productionBatches ProductionBatch[]
  materialUsages    ProductionMaterialUsage[]
  expenses          Expense[]
  monthlySalary     Decimal                   @default(0) @db.Decimal(12, 2)
  hireDate          DateTime?
  isActive          Boolean                   @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, employeeCode])
  @@index([businessId, fullName])
}

model Supplier {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  purchases   Purchase[]
  isActive    Boolean    @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
}

model UnitOfMeasure {
  id         String @id @default(cuid())
  businessId String
  name       String
  code       String

  business  Business   @relation(fields: [businessId], references: [id])
  materials Material[]

  createdAt DateTime @default(now())

  @@unique([businessId, code])
}

model Material {
  id           String       @id @default(cuid())
  businessId   String
  unitId       String
  name         String
  sku          String?
  type         MaterialType @default(OTHER)
  description  String?
  reorderLevel Decimal      @default(0) @db.Decimal(14, 3)
  isActive     Boolean      @default(true)

  purchaseItems            PurchaseItem[]
  stockMovements           StockMovement[]
  costLayers               MaterialCostLayer[]
  productionMaterialUsages ProductionMaterialUsage[]

  business Business      @relation(fields: [businessId], references: [id])
  unit     UnitOfMeasure @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, name])
}

model Product {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  sku         String?
  description String?
  category    String?
  orderItems  OrderItem[]
  basePrice   Decimal?    @db.Decimal(12, 2)
  isActive    Boolean     @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, name])
}

model Purchase {
  id           String         @id @default(cuid())
  businessId   String
  supplierId   String
  purchaseNo   String
  status       PurchaseStatus @default(DRAFT)
  purchaseDate DateTime       @default(now())
  receivedAt   DateTime?
  subtotal     Decimal        @default(0) @db.Decimal(14, 2)
  notes        String?

  business Business       @relation(fields: [businessId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, purchaseNo])
  @@index([businessId, purchaseDate])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  materialId String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(14, 2)
  totalCost  Decimal @db.Decimal(14, 2)

  costLayer MaterialCostLayer?

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())

  @@index([materialId])
}

model StockMovement {
  id            String            @id @default(cuid())
  businessId    String
  materialId    String
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  referenceId   String?
  referenceType String?
  notes         String?
  movementDate  DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, materialId, movementDate])
}

model MaterialCostLayer {
  id             String          @id @default(cuid())
  businessId     String
  materialId     String
  // purchaseItemId String
  originalQty    Decimal         @db.Decimal(14, 3)
  remainingQty   Decimal         @db.Decimal(14, 3)
  unitCost       Decimal         @db.Decimal(14, 2)
  status         CostLayerStatus @default(OPEN)
  purchaseItemId String          @unique
  purchaseItem   PurchaseItem    @relation(fields: [purchaseItemId], references: [id])

  business Business @relation(fields: [businessId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, materialId, status])
}

model CustomerOrder {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  orderNo     String
  status      OrderStatus @default(PENDING)
  orderDate   DateTime    @default(now())
  dueDate     DateTime?
  notes       String?
  invoice     Invoice?
  totalAmount Decimal     @default(0) @db.Decimal(14, 2)

  business Business          @relation(fields: [businessId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  batches  ProductionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, orderNo])
  @@index([businessId, status])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  description String?

  order   CustomerOrder @relation(fields: [orderId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model ProductionBatch {
  id                String           @id @default(cuid())
  businessId        String
  orderId           String
  employeeId        String?
  batchNo           String
  status            ProductionStatus @default(PLANNED)
  plannedQuantity   Int
  completedQuantity Int              @default(0)
  startDate         DateTime?
  completedAt       DateTime?
  notes             String?

  business       Business                  @relation(fields: [businessId], references: [id])
  order          CustomerOrder             @relation(fields: [orderId], references: [id])
  employee       Employee?                 @relation(fields: [employeeId], references: [id])
  materialUsages ProductionMaterialUsage[]
  costSheet      ProductionCostSheet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, batchNo])
  @@index([businessId, status])
  @@index([orderId])
}

model ProductionMaterialUsage {
  id                String  @id @default(cuid())
  businessId        String
  productionBatchId String
  materialId        String
  employeeId        String?

  issuedQuantity   Decimal @db.Decimal(14, 3)
  consumedQuantity Decimal @db.Decimal(14, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(14, 3)
  wastedQuantity   Decimal @default(0) @db.Decimal(14, 3)

  unitCostSnapshot Decimal @db.Decimal(14, 2)
  totalCost        Decimal @db.Decimal(14, 2)

  notes String?

  business        Business        @relation(fields: [businessId], references: [id])
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id])
  material        Material        @relation(fields: [materialId], references: [id])
  employee        Employee?       @relation(fields: [employeeId], references: [id])

  recordedAt DateTime @default(now())

  @@index([businessId, productionBatchId])
  @@index([materialId])
  @@index([employeeId])
}

model ProductionCostSheet {
  id                String @id @default(cuid())
  businessId        String
  productionBatchId String @unique

  materialCost    Decimal @default(0) @db.Decimal(14, 2)
  otherDirectCost Decimal @default(0) @db.Decimal(14, 2)
  totalDirectCost Decimal @default(0) @db.Decimal(14, 2)

  costedQuantity     Int
  breakEvenUnitPrice Decimal @default(0) @db.Decimal(14, 2)

  markupPercent      Decimal @default(20) @db.Decimal(5, 2)
  suggestedUnitPrice Decimal @default(0) @db.Decimal(14, 2)

  notes        String?
  calculatedAt DateTime @default(now())

  business        Business        @relation(fields: [businessId], references: [id])
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, calculatedAt])
}

model Expense {
  id         String  @id @default(cuid())
  businessId String
  employeeId String?

  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @default(now())
  periodMonth DateTime?
  reference   String?
  notes       String?

  business Business  @relation(fields: [businessId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, expenseDate])
  @@index([businessId, category])
  @@index([employeeId])
}

model Invoice {
  id         String  @id @default(cuid())
  businessId String
  customerId String
  orderId    String? @unique

  invoiceNo String
  status    InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  business Business       @relation(fields: [businessId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  order    CustomerOrder? @relation(fields: [orderId], references: [id])
  payments Payment[]
  items    InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNo])
  @@index([businessId, status])
  @@index([customerId])
  @@index([businessId, issueDate])
}

model Payment {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String

  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paymentDate DateTime      @default(now())

  reference String?
  notes     String?

  business Business @relation(fields: [businessId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, paymentDate])
  @@index([invoiceId])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
