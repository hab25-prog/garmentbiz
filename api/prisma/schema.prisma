generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  INVENTORY_MANAGER
  PRODUCTION_MANAGER
  EMPLOYEE
}

model Business {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  phone     String?
  email     String?
  address   String?
  currency  String  @default("ETB")
  timezone  String  @default("Africa/Addis_Ababa")
  isActive  Boolean @default(true)

  memberships              Membership[]
  customers                Customer[]
  employees                Employee[]
  suppliers                Supplier[]
  units                    UnitOfMeasure[]
  materials                Material[]
  products                 Product[]
  productMaterialRequirements ProductMaterialRequirement[]
  orderMaterialEstimates OrderMaterialEstimate[]
  orderMaterialEstimateItems OrderMaterialEstimateItem[]
  orderMaterialEstimateMaterials OrderMaterialEstimateMaterial[]
  purchases                Purchase[]
  stockMovements           StockMovement[]
  costLayers               MaterialCostLayer[]
  orders                   CustomerOrder[]
  productionBatches        ProductionBatch[]
  productionMaterialUsages ProductionMaterialUsage[]
  expenses                 Expense[]
  productionCostSheets     ProductionCostSheet[]
  materialCostAllocations  MaterialCostAllocation[]
  inventoryOperations      InventoryOperation[]
  inventoryCostAllocations InventoryCostAllocation[]
  unitConversions          UnitConversion[]
  invoices                 Invoice[]
  payments                 Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(cuid())
  fullName     String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id         String         @id @default(cuid())
  businessId String
  userId     String
  role       MembershipRole @default(EMPLOYEE)
  isActive   Boolean        @default(true)

  business            Business             @relation(fields: [businessId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  sessions            Session[]
  inventoryOperations InventoryOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
}

model Session {
  id                 String    @id @default(cuid())
  membershipId       String
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  rotatedToSessionId String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, expiresAt])
}

model Customer {
  id         String          @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  orders     CustomerOrder[]
  invoices   Invoice[]
  isActive   Boolean         @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
  @@index([businessId, phone])
}

enum MaterialType {
  FABRIC
  POLYMER
  THREAD
  ACCESSORY
  PACKAGING
  OTHER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  MANUAL_RECEIPT
  INVENTORY_ISSUE
  INVENTORY_RETURN
  INVENTORY_WASTE
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum CostLayerStatus {
  OPEN
  DEPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  DELIVERED
  CANCELLED
}

enum OrderMaterialEstimateStatus {
  COMPLETE
  INCOMPLETE
}

enum OrderMaterialEstimateLineStatus {
  COMPLETE
  INSUFFICIENT_STOCK
  NO_COST_LAYERS
  INVENTORY_DISCREPANCY
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  TRANSPORT
  MAINTENANCE
  SUPPLIES
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

model Employee {
  id                String                    @id @default(cuid())
  businessId        String
  employeeCode      String?
  fullName          String
  phone             String?
  jobTitle          String?
  productionBatches ProductionBatch[]
  materialUsages    ProductionMaterialUsage[]
  expenses          Expense[]
  monthlySalary     Decimal                   @default(0) @db.Decimal(12, 2)
  hireDate          DateTime?
  isActive          Boolean                   @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, employeeCode])
  @@index([businessId, fullName])
}

model Supplier {
  id                  String               @id @default(cuid())
  businessId          String
  name                String
  contactName         String?
  phone               String?
  email               String?
  address             String?
  notes               String?
  purchases           Purchase[]
  inventoryOperations InventoryOperation[]
  isActive            Boolean              @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
}

model UnitOfMeasure {
  id         String @id @default(cuid())
  businessId String
  name       String
  code       String

  business        Business         @relation(fields: [businessId], references: [id])
  materials       Material[]
  conversionsFrom UnitConversion[] @relation("ConversionFrom")
  conversionsTo   UnitConversion[] @relation("ConversionTo")
  orderMaterialEstimates OrderMaterialEstimateMaterial[]

  createdAt DateTime @default(now())

  @@unique([businessId, code])
}

model Material {
  id           String       @id @default(cuid())
  businessId   String
  unitId       String
  name         String
  sku          String?
  type         MaterialType @default(OTHER)
  description  String?
  reorderLevel Decimal      @default(0) @db.Decimal(14, 3)
  isActive     Boolean      @default(true)

  purchaseItems            PurchaseItem[]
  stockMovements           StockMovement[]
  costLayers               MaterialCostLayer[]
  productionMaterialUsages ProductionMaterialUsage[]
  inventoryOperations      InventoryOperation[]
  productRequirements      ProductMaterialRequirement[]
  orderMaterialEstimates   OrderMaterialEstimateMaterial[]

  business Business      @relation(fields: [businessId], references: [id])
  unit     UnitOfMeasure @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, name])
}

model Product {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  sku         String?
  description String?
  category    String?
  orderItems  OrderItem[]
  materialRequirements ProductMaterialRequirement[]
  orderMaterialEstimateItems OrderMaterialEstimateItem[]
  basePrice   Decimal?    @db.Decimal(12, 2)
  isActive    Boolean     @default(true)

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, name])
}

model ProductMaterialRequirement {
  id                String   @id @default(cuid())
  businessId        String
  productId         String
  materialId        String
  quantityPerUnit   Decimal  @db.Decimal(14, 3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, materialId])
  @@index([businessId, productId])
  @@index([businessId, materialId])
}

model Purchase {
  id           String         @id @default(cuid())
  businessId   String
  supplierId   String
  purchaseNo   String
  status       PurchaseStatus @default(DRAFT)
  purchaseDate DateTime       @default(now())
  receivedAt   DateTime?
  subtotal     Decimal        @default(0) @db.Decimal(14, 2)
  notes        String?

  business Business       @relation(fields: [businessId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, purchaseNo])
  @@index([businessId, purchaseDate])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  materialId String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(14, 2)
  totalCost  Decimal @db.Decimal(14, 2)

  costLayer MaterialCostLayer?

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())

  @@index([materialId])
}

model StockMovement {
  id                   String            @id @default(cuid())
  businessId           String
  materialId           String
  movementType         StockMovementType
  quantity             Decimal           @db.Decimal(14, 3)
  referenceId          String?
  referenceType        String?
  notes                String?
  movementDate         DateTime          @default(now())
  inventoryOperationId String?           @unique
  unitCostSnapshot     Decimal?          @db.Decimal(14, 2)
  reason               String?

  business           Business            @relation(fields: [businessId], references: [id])
  material           Material            @relation(fields: [materialId], references: [id])
  inventoryOperation InventoryOperation? @relation(fields: [inventoryOperationId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, materialId, movementDate])
}

model MaterialCostLayer {
  id                   String                    @id @default(cuid())
  businessId           String
  materialId           String
  // purchaseItemId String
  originalQty          Decimal                   @db.Decimal(14, 3)
  remainingQty         Decimal                   @db.Decimal(14, 3)
  unitCost             Decimal                   @db.Decimal(14, 2)
  status               CostLayerStatus           @default(OPEN)
  purchaseItemId       String?                   @unique
  sourceOperationId    String?                   @unique
  sourceType           InventoryLayerSource      @default(PURCHASE)
  receivedAt           DateTime                  @default(now())
  purchaseItem         PurchaseItem?             @relation(fields: [purchaseItemId], references: [id])
  sourceOperation      InventoryOperation?       @relation(fields: [sourceOperationId], references: [id])
  allocations          MaterialCostAllocation[]
  inventoryAllocations InventoryCostAllocation[]
  orderEstimateLayers  OrderMaterialEstimateLayer[]

  business Business @relation(fields: [businessId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, materialId, status])
}

enum InventoryLayerSource {
  PURCHASE
  MANUAL_RECEIPT
  ADJUSTMENT_IN
}

enum InventoryOperationType {
  MANUAL_RECEIPT
  ISSUE
  RETURN
  WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model InventoryOperation {
  id                      String                    @id @default(cuid())
  businessId              String
  materialId              String
  supplierId              String?
  performedByMembershipId String
  operationType           InventoryOperationType
  quantity                Decimal                   @db.Decimal(14, 3)
  unitCost                Decimal?                  @db.Decimal(14, 2)
  reason                  String
  reference               String?
  operationKey            String
  reversesOperationId     String?
  movement                StockMovement?
  costLayer               MaterialCostLayer?
  allocations             InventoryCostAllocation[]
  returnedFrom            InventoryOperation?       @relation("InventoryReturns", fields: [reversesOperationId], references: [id])
  returns                 InventoryOperation[]      @relation("InventoryReturns")
  business                Business                  @relation(fields: [businessId], references: [id])
  material                Material                  @relation(fields: [materialId], references: [id])
  supplier                Supplier?                 @relation(fields: [supplierId], references: [id])
  performedBy             Membership                @relation(fields: [performedByMembershipId], references: [id])
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([businessId, operationKey])
  @@index([businessId, materialId, createdAt])
  @@index([businessId, operationType, createdAt])
}

model InventoryCostAllocation {
  id                   String             @id @default(cuid())
  businessId           String
  inventoryOperationId String
  materialCostLayerId  String
  allocatedQuantity    Decimal            @db.Decimal(14, 3)
  returnedQuantity     Decimal            @default(0) @db.Decimal(14, 3)
  unitCostSnapshot     Decimal            @db.Decimal(14, 2)
  business             Business           @relation(fields: [businessId], references: [id])
  inventoryOperation   InventoryOperation @relation(fields: [inventoryOperationId], references: [id])
  materialCostLayer    MaterialCostLayer  @relation(fields: [materialCostLayerId], references: [id])
  createdAt            DateTime           @default(now())

  @@unique([inventoryOperationId, materialCostLayerId])
  @@index([businessId, inventoryOperationId])
  @@index([materialCostLayerId])
}

model UnitConversion {
  id         String        @id @default(cuid())
  businessId String
  fromUnitId String
  toUnitId   String
  factor     Decimal       @db.Decimal(18, 9)
  business   Business      @relation(fields: [businessId], references: [id])
  fromUnit   UnitOfMeasure @relation("ConversionFrom", fields: [fromUnitId], references: [id])
  toUnit     UnitOfMeasure @relation("ConversionTo", fields: [toUnitId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([businessId, fromUnitId, toUnitId])
  @@index([businessId])
}

model CustomerOrder {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  orderNo     String
  status      OrderStatus @default(PENDING)
  orderDate   DateTime    @default(now())
  dueDate     DateTime?
  notes       String?
  invoice     Invoice?
  totalAmount Decimal     @default(0) @db.Decimal(14, 2)

  business Business          @relation(fields: [businessId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  batches  ProductionBatch[]
  materialEstimates OrderMaterialEstimate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, orderNo])
  @@index([businessId, status])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)
  description String?

  order             CustomerOrder     @relation(fields: [orderId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  productionBatches ProductionBatch[]
  materialEstimates OrderMaterialEstimateItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderMaterialEstimate {
  id                 String                       @id @default(cuid())
  businessId         String
  orderId            String
  status             OrderMaterialEstimateStatus
  totalMaterialCost  Decimal?                     @db.Decimal(14, 2)
  estimatedAt        DateTime                     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order    CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items    OrderMaterialEstimateItem[]
  materials OrderMaterialEstimateMaterial[]

  @@index([businessId, orderId, estimatedAt])
}

model OrderMaterialEstimateItem {
  id                   String   @id @default(cuid())
  businessId           String
  estimateId           String
  orderItemId          String
  productId            String
  productNameSnapshot  String
  orderedQuantity      Int
  hasBom               Boolean

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  estimate       OrderMaterialEstimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  orderItem      OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  requirements   OrderMaterialEstimateRequirement[]

  @@unique([estimateId, orderItemId])
  @@index([businessId, estimateId])
}

model OrderMaterialEstimateMaterial {
  id                      String                              @id @default(cuid())
  businessId              String
  estimateId              String
  materialId              String
  materialNameSnapshot    String
  baseUnitId              String
  baseUnitNameSnapshot    String
  baseUnitCodeSnapshot    String
  requiredQuantity        Decimal                             @db.Decimal(14, 3)
  availableQuantity       Decimal                             @db.Decimal(14, 3)
  fifoAvailableQuantity   Decimal                             @db.Decimal(14, 3)
  shortageQuantity        Decimal                             @db.Decimal(14, 3)
  status                  OrderMaterialEstimateLineStatus
  estimatedCost           Decimal?                            @db.Decimal(14, 2)

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  estimate       OrderMaterialEstimate @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  material       Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  baseUnit       UnitOfMeasure         @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  requirements   OrderMaterialEstimateRequirement[]
  fifoLayers     OrderMaterialEstimateLayer[]

  @@unique([estimateId, materialId])
  @@index([businessId, estimateId])
}

model OrderMaterialEstimateRequirement {
  id                       String                       @id @default(cuid())
  estimateItemId           String
  materialEstimateId       String
  quantityPerProduct       Decimal                      @db.Decimal(14, 3)
  requiredQuantity         Decimal                      @db.Decimal(14, 3)

  estimateItem     OrderMaterialEstimateItem     @relation(fields: [estimateItemId], references: [id], onDelete: Restrict)
  materialEstimate OrderMaterialEstimateMaterial @relation(fields: [materialEstimateId], references: [id], onDelete: Restrict)

  @@unique([estimateItemId, materialEstimateId])
  @@index([materialEstimateId])
}

model OrderMaterialEstimateLayer {
  id                       String                       @id @default(cuid())
  materialEstimateId       String
  materialCostLayerId      String
  layerReceivedAtSnapshot  DateTime
  layerAvailableQuantity   Decimal                      @db.Decimal(14, 3)
  allocatedQuantity        Decimal                      @db.Decimal(14, 3)
  unitCostSnapshot         Decimal                      @db.Decimal(14, 2)
  estimatedCost            Decimal                      @db.Decimal(14, 2)

  materialEstimate  OrderMaterialEstimateMaterial @relation(fields: [materialEstimateId], references: [id], onDelete: Restrict)
  materialCostLayer MaterialCostLayer             @relation(fields: [materialCostLayerId], references: [id], onDelete: Restrict)

  @@unique([materialEstimateId, materialCostLayerId])
  @@index([materialEstimateId])
}

model ProductionBatch {
  id                String           @id @default(cuid())
  businessId        String
  orderId           String
  orderItemId       String?
  employeeId        String?
  batchNo           String
  status            ProductionStatus @default(PLANNED)
  plannedQuantity   Int
  completedQuantity Int              @default(0)
  startDate         DateTime?
  completedAt       DateTime?
  notes             String?

  business       Business                  @relation(fields: [businessId], references: [id])
  order          CustomerOrder             @relation(fields: [orderId], references: [id])
  orderItem      OrderItem?                @relation(fields: [orderItemId], references: [id])
  employee       Employee?                 @relation(fields: [employeeId], references: [id])
  materialUsages ProductionMaterialUsage[]
  costSheet      ProductionCostSheet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, batchNo])
  @@index([businessId, status])
  @@index([orderId])
}

model ProductionMaterialUsage {
  id                String  @id @default(cuid())
  businessId        String
  productionBatchId String
  materialId        String
  employeeId        String?

  issuedQuantity   Decimal @db.Decimal(14, 3)
  consumedQuantity Decimal @db.Decimal(14, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(14, 3)
  wastedQuantity   Decimal @default(0) @db.Decimal(14, 3)

  unitCostSnapshot Decimal @db.Decimal(14, 2)
  totalCost        Decimal @db.Decimal(14, 2)

  notes String?

  business        Business                 @relation(fields: [businessId], references: [id])
  productionBatch ProductionBatch          @relation(fields: [productionBatchId], references: [id])
  material        Material                 @relation(fields: [materialId], references: [id])
  costAllocations MaterialCostAllocation[]
  employee        Employee?                @relation(fields: [employeeId], references: [id])

  recordedAt DateTime @default(now())

  @@index([businessId, productionBatchId])
  @@index([materialId])
  @@index([employeeId])
}

model MaterialCostAllocation {
  id                        String @id @default(cuid())
  businessId                String
  productionMaterialUsageId String
  materialCostLayerId       String

  allocatedQuantity Decimal @db.Decimal(14, 3)
  returnedQuantity  Decimal @default(0) @db.Decimal(14, 3)
  unitCostSnapshot  Decimal @db.Decimal(14, 2)

  business                Business                @relation(fields: [businessId], references: [id])
  productionMaterialUsage ProductionMaterialUsage @relation(fields: [productionMaterialUsageId], references: [id])
  materialCostLayer       MaterialCostLayer       @relation(fields: [materialCostLayerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productionMaterialUsageId, materialCostLayerId])
  @@index([businessId, productionMaterialUsageId])
  @@index([materialCostLayerId])
}

model ProductionCostSheet {
  id                String @id @default(cuid())
  businessId        String
  productionBatchId String @unique

  materialCost    Decimal @default(0) @db.Decimal(14, 2)
  laborCost       Decimal @default(0) @db.Decimal(14, 2)
  otherDirectCost Decimal @default(0) @db.Decimal(14, 2)
  totalDirectCost Decimal @default(0) @db.Decimal(14, 2)

  costedQuantity     Int
  breakEvenUnitPrice Decimal @default(0) @db.Decimal(14, 2)

  markupPercent      Decimal @default(20) @db.Decimal(5, 2)
  suggestedUnitPrice Decimal @default(0) @db.Decimal(14, 2)

  notes        String?
  calculatedAt DateTime @default(now())

  business        Business        @relation(fields: [businessId], references: [id])
  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, calculatedAt])
}

model Expense {
  id         String  @id @default(cuid())
  businessId String
  employeeId String?

  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @default(now())
  periodMonth DateTime?
  reference   String?
  notes       String?

  business Business  @relation(fields: [businessId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, expenseDate])
  @@index([businessId, category])
  @@index([employeeId])
}

model Invoice {
  id         String  @id @default(cuid())
  businessId String
  customerId String
  orderId    String? @unique

  invoiceNo String
  status    InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  business Business       @relation(fields: [businessId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  order    CustomerOrder? @relation(fields: [orderId], references: [id])
  payments Payment[]
  items    InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNo])
  @@index([businessId, status])
  @@index([customerId])
  @@index([businessId, issueDate])
}

model Payment {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String

  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paymentDate DateTime      @default(now())

  reference String?
  notes     String?

  business Business @relation(fields: [businessId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, paymentDate])
  @@index([invoiceId])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
